#!/bin/sh
IFACE="wlan0"
CONF="/etc/wpa_supplicant.conf"
PIDFILE="/var/run/wpa_supplicant.pid"

case "$1" in
    start)
        exec >> /boot/wpa.log 2>&1
        printf "Starting wpa_supplicant: "
        modprobe brcmfmac
        mkdir -p /var/run/wpa_supplicant
        ASSOC=0
        for i in $(seq 1 20); do
            ip link show $IFACE > /dev/null 2>&1 || { sleep 1; continue; }
            wpa_supplicant -B -D nl80211 -i $IFACE -c $CONF -P $PIDFILE 2>/dev/null && \
            wpa_cli status 2>/dev/null | grep -q "wpa_state=COMPLETED" && ASSOC=1 && break
            sleep 1
        done
        [ $ASSOC -eq 0 ] && echo "FAIL: wpa_supplicant did not associate" && exit 1
        echo "OK"
        ;;
    stop)
        printf "Stopping wpa_supplicant: "
        kill $(cat $PIDFILE) 2>/dev/null || true
        rm -f $PIDFILE
        echo "OK"
        ;;
    restart|reload)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
