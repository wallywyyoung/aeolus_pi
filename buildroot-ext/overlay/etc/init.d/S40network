#!/bin/sh

mkdir -p /run/network
case "$1" in
    start)
        printf "Starting network: "
        /sbin/ifup -a
        # Wait for wlan0 to get an IP
        for i in $(seq 1 30); do
            ip addr show wlan0 | grep -q "inet " && break || sleep 1
        done
        [ $? = 0 ] && echo "OK" || echo "FAIL"
        ;;
    stop)
        printf "Stopping network: "
        /sbin/ifdown -a
        [ $? = 0 ] && echo "OK" || echo "FAIL"
        ;;
    restart|reload)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
exit $?