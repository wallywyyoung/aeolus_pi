#!/bin/sh
mount /dev/mmcblk0p1 /boot 2>/dev/null || true
exec > /boot/boot.log 2>&1
set -x
echo "=== $(date) ==="
cat /proc/cmdline
dmesg
echo "=== network interfaces ==="
cat /etc/network/interfaces
echo "=== wpa_supplicant config ==="
cat /etc/wpa_supplicant.conf
echo "=== ifup output ==="
/sbin/ifup -a -v
echo "=== ip addr ==="
ip addr